rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function textBetween(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function optionalText(data, key, maximum) {
      return data.get(key, null) == null ||
        (data.get(key, null) is string && data.get(key, null).size() <= maximum);
    }

    function optionalNumber(data, key, minimum, maximum) {
      return data.get(key, null) == null ||
        (data.get(key, null) is int &&
          data.get(key, null) >= minimum &&
          data.get(key, null) <= maximum);
    }

    function validUser(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'createdAtMs', 'migrationState', 'revision'
        ]) &&
        data.keys().hasAll([
          'schemaVersion', 'createdAtMs', 'migrationState', 'revision'
        ]) &&
        data.schemaVersion == 1 &&
        data.createdAtMs is int && data.createdAtMs > 0 &&
        data.revision is int && data.revision >= 0 &&
        data.migrationState in ['pending', 'ready', 'paused'];
    }

    function validPet(petId, data) {
      return data.keys().hasAll([
          'id', 'schemaVersion', 'revision', 'name', 'species',
          'isArchived', 'createdAtMs', 'updatedAtMs'
        ]) &&
        data.keys().hasOnly([
          'id', 'schemaVersion', 'revision', 'name', 'species',
          'isArchived', 'createdAtMs', 'updatedAtMs',
          'breed', 'birthday', 'estimatedAgeYears', 'sex',
          'neuterStatus', 'notes', 'photoFile', 'deletedAtMs', 'lastSyncOpId'
        ]) &&
        data.id == petId && textBetween(data.id, 100) &&
        data.schemaVersion == 1 &&
        data.revision is int && data.revision >= 0 &&
        textBetween(data.name, 40) &&
        data.species in ['CAT', 'DOG', 'OTHER'] &&
        data.isArchived is bool &&
        data.createdAtMs is int && data.createdAtMs > 0 &&
        data.updatedAtMs is int && data.updatedAtMs >= data.createdAtMs &&
        optionalText(data, 'breed', 100) &&
        optionalText(data, 'birthday', 16) &&
        optionalNumber(data, 'estimatedAgeYears', 0, 100) &&
        optionalText(data, 'sex', 40) &&
        optionalText(data, 'neuterStatus', 40) &&
        optionalText(data, 'notes', 2000) &&
        optionalText(data, 'photoFile', 100) &&
        optionalNumber(data, 'deletedAtMs', 1, 9999999999999);
    }

    function validCare(petId, recordId, data) {
      return data.keys().hasAll([
          'id', 'petId', 'schemaVersion', 'revision', 'type', 'occurredAtMs',
          'timezoneId', 'note', 'createdAtMs', 'updatedAtMs'
        ]) &&
        data.keys().hasOnly([
          'id', 'petId', 'schemaVersion', 'revision', 'type', 'occurredAtMs',
          'timezoneId', 'note', 'createdAtMs', 'updatedAtMs',
          'foodKind', 'foodProductName', 'foodServedMilli', 'foodConsumedMilli',
          'foodUnit', 'waterMl', 'eliminationKind', 'eliminationCount',
          'activityKind', 'activityMinutes', 'weightGrams', 'weightInputUnit',
          'photoFile', 'deletedAtMs', 'lastSyncOpId'
        ]) &&
        data.id == recordId && textBetween(data.id, 100) &&
        data.petId == petId &&
        data.schemaVersion == 1 &&
        data.revision is int && data.revision >= 0 &&
        data.type in ['FOOD', 'WATER', 'ELIMINATION', 'ACTIVITY', 'WEIGHT'] &&
        data.occurredAtMs is int && data.occurredAtMs > 0 &&
        textBetween(data.timezoneId, 64) &&
        data.note is string && data.note.size() <= 2000 &&
        data.createdAtMs is int && data.createdAtMs > 0 &&
        data.updatedAtMs is int && data.updatedAtMs >= data.createdAtMs &&
        optionalText(data, 'foodKind', 40) &&
        optionalText(data, 'foodProductName', 200) &&
        optionalNumber(data, 'foodServedMilli', 0, 9999999999999) &&
        optionalNumber(data, 'foodConsumedMilli', 0, 9999999999999) &&
        optionalText(data, 'foodUnit', 8) &&
        optionalNumber(data, 'waterMl', 0, 1000000000) &&
        optionalText(data, 'eliminationKind', 40) &&
        optionalNumber(data, 'eliminationCount', 0, 100) &&
        optionalText(data, 'activityKind', 40) &&
        optionalNumber(data, 'activityMinutes', 0, 1440) &&
        optionalNumber(data, 'weightGrams', 0, 9999999999999) &&
        optionalText(data, 'weightInputUnit', 8) &&
        optionalText(data, 'photoFile', 100) &&
        optionalNumber(data, 'deletedAtMs', 1, 9999999999999);
    }

    function validOpId(id) {
      return id is string &&
        id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validUser(request.resource.data) &&
        request.resource.data.revision == 0;
      allow update: if owner(uid) &&
        validUser(request.resource.data) &&
        request.resource.data.createdAtMs == resource.data.createdAtMs &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      match /syncReceipts/{opId} {
        allow get: if owner(uid);
        allow list, update, delete: if false;
        allow create: if owner(uid) && readyAccount(uid) &&
          validReceipt(opId, request.resource.data) &&
          ((request.resource.data.entityKind == 'PET' &&
            receiptTargetMatches(
              /databases/$(database)/documents/users/$(uid)/pets/$(request.resource.data.petId),
              request.resource.data)) ||
           (request.resource.data.entityKind == 'CARE' &&
            receiptTargetMatches(
              /databases/$(database)/documents/users/$(uid)/pets/$(request.resource.data.petId)/records/$(request.resource.data.entityId),
              request.resource.data)));
      }

      match /pets/{petId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid) &&
          validPet(petId, request.resource.data) &&
          request.resource.data.revision == 0 &&
          permittedCreate(uid, 'PET', petId, petId, request.resource.data);
        allow update: if owner(uid) &&
          validPet(petId, request.resource.data) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAtMs == resource.data.createdAtMs &&
          request.resource.data.revision == resource.data.revision + 1 &&
          permittedUpdate(uid, 'PET', petId, petId, resource.data, request.resource.data);
        allow delete: if false;

        match /records/{recordId} {
          allow get, list: if owner(uid);
          allow create: if owner(uid) &&
            activeParent(uid, petId) &&
            validCare(petId, recordId, request.resource.data) &&
            request.resource.data.revision == 0 &&
            permittedCreate(uid, 'CARE', petId, recordId, request.resource.data);
          allow update: if owner(uid) &&
            validCare(petId, recordId, request.resource.data) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.petId == resource.data.petId &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.createdAtMs == resource.data.createdAtMs &&
            request.resource.data.revision == resource.data.revision + 1 &&
            activeParent(uid, petId) &&
            permittedUpdate(uid, 'CARE', petId, recordId, resource.data, request.resource.data);
          allow delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
);
    }

    function readyAccount(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid));
      return user.data.migrationState == 'ready';
    }

    function validReceipt(opId, data) {
      return data.keys().hasAll([
          'opId', 'entityKind', 'petId', 'entityId', 'operation',
          'expectedRevision', 'resultingRevision', 'requestDigest'
        ]) && data.keys().hasOnly([
          'opId', 'entityKind', 'petId', 'entityId', 'operation',
          'expectedRevision', 'resultingRevision', 'requestDigest'
        ]) &&
        validOpId(opId) && data.opId == opId &&
        data.entityKind in ['PET', 'CARE'] &&
        textBetween(data.petId, 100) && textBetween(data.entityId, 100) &&
        !data.petId.matches('.*[/].*') && !data.entityId.matches('.*[/].*') &&
        (data.entityKind != 'PET' || data.petId == data.entityId) &&
        data.operation in ['CREATE', 'UPDATE', 'DELETE'] &&
        data.expectedRevision is int && data.resultingRevision is int &&
        data.resultingRevision == data.expectedRevision + 1 &&
        ((data.operation == 'CREATE' && data.expectedRevision == -1) ||
          (data.operation in ['UPDATE', 'DELETE'] && data.expectedRevision >= 0)) &&
        data.requestDigest is string && data.requestDigest.matches('^[0-9a-f]{64}
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validUser(request.resource.data) &&
        request.resource.data.revision == 0;
      allow update: if owner(uid) &&
        validUser(request.resource.data) &&
        request.resource.data.createdAtMs == resource.data.createdAtMs &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      match /pets/{petId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid) &&
          validPet(petId, request.resource.data) &&
          request.resource.data.revision == 0;
        allow update: if owner(uid) &&
          validPet(petId, request.resource.data) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAtMs == resource.data.createdAtMs &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;

        match /records/{recordId} {
          allow get, list: if owner(uid);
          allow create: if owner(uid) &&
            exists(/databases/$(database)/documents/users/$(uid)/pets/$(petId)) &&
            validCare(petId, recordId, request.resource.data) &&
            request.resource.data.revision == 0;
          allow update: if owner(uid) &&
            validCare(petId, recordId, request.resource.data) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.petId == resource.data.petId &&
            request.resource.data.createdAtMs == resource.data.createdAtMs &&
            request.resource.data.revision == resource.data.revision + 1;
          allow delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
);
    }

    function matchesSyncReceipt(uid, kind, petId, entityId, oldRevision, data) {
      let opId = data.get('lastSyncOpId', '');
      let path = /databases/$(database)/documents/users/$(uid)/syncReceipts/$(opId);
      let receipt = getAfter(path).data;
      return validOpId(opId) && readyAccount(uid) &&
        !exists(path) && validReceipt(opId, receipt) &&
        receipt.entityKind == kind && receipt.petId == petId &&
        receipt.entityId == entityId && receipt.expectedRevision == oldRevision &&
        receipt.resultingRevision == data.revision &&
        ((receipt.operation == 'DELETE' && data.get('deletedAtMs', null) != null) ||
          (receipt.operation != 'DELETE' && data.get('deletedAtMs', null) == null));
    }

    // Preserve the prior first-import path; once synchronized, writes cannot remove
    // their receipt linkage or bypass the new atomic protocol.
    function permittedCreate(uid, kind, petId, entityId, data) {
      return (!data.keys().hasAny(['lastSyncOpId', 'deletedAtMs'])) ||
        (data.get('photoFile', null) == null &&
          matchesSyncReceipt(uid, kind, petId, entityId, -1, data));
    }

    function permittedUpdate(uid, kind, petId, entityId, before, after) {
      return before.get('deletedAtMs', null) == null &&
        ((!before.keys().hasAny(['lastSyncOpId']) &&
          !after.keys().hasAny(['lastSyncOpId', 'deletedAtMs'])) ||
          (before.get('photoFile', null) == after.get('photoFile', null) &&
            matchesSyncReceipt(uid, kind, petId, entityId, before.revision, after)));
    }

    function activeParent(uid, petId) {
      let path = /databases/$(database)/documents/users/$(uid)/pets/$(petId);
      return exists(path) && get(path).data.get('deletedAtMs', null) == null;
    }

    function receiptTargetMatches(target, data) {
      let next = getAfter(target).data;
      return existsAfter(target) &&
        next.get('lastSyncOpId', '') == data.opId &&
        next.revision == data.resultingRevision &&
        ((data.operation == 'CREATE' && !exists(target)) ||
          (data.operation != 'CREATE' && exists(target) &&
            get(target).data.revision == data.expectedRevision &&
            get(target).data.get('deletedAtMs', null) == null));
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validUser(request.resource.data) &&
        request.resource.data.revision == 0;
      allow update: if owner(uid) &&
        validUser(request.resource.data) &&
        request.resource.data.createdAtMs == resource.data.createdAtMs &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      match /pets/{petId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid) &&
          validPet(petId, request.resource.data) &&
          request.resource.data.revision == 0;
        allow update: if owner(uid) &&
          validPet(petId, request.resource.data) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAtMs == resource.data.createdAtMs &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;

        match /records/{recordId} {
          allow get, list: if owner(uid);
          allow create: if owner(uid) &&
            exists(/databases/$(database)/documents/users/$(uid)/pets/$(petId)) &&
            validCare(petId, recordId, request.resource.data) &&
            request.resource.data.revision == 0;
          allow update: if owner(uid) &&
            validCare(petId, recordId, request.resource.data) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.petId == resource.data.petId &&
            request.resource.data.createdAtMs == resource.data.createdAtMs &&
            request.resource.data.revision == resource.data.revision + 1;
          allow delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
